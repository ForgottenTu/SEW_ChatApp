@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject ILogger<Chat> Log
@rendermode InteractiveAuto

<PageTitle>Chat</PageTitle>

@if (!_isRegistered)
{
    <div class="form-group">
        <label for="user-name-input">Choose a nickname:</label>
        <input id="user-name-input" @bind="_userName" class="form-control" />

        <button class="btn btn-primary mt-2"
                @onclick="ConfirmUserName">
            Confirm
        </button>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-2">@ErrorMessage</div>
        }
    </div>
}
else
{
    <div class="row">
        <!-- ── left column – rooms & actions ────────────────────────────── -->
        <div class="col-md-4">
            <h4>Hello, @_userName!</h4>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }

            <h5 class="mt-4">Create a room</h5>
            <div class="input-group mb-3">
                <input class="form-control"
                       placeholder="Room name"
                       @bind="CreateRoomName" />
                <button class="btn btn-success"
                        @onclick="CreateRoom">
                    Create
                </button>
            </div>

            <h5>Available rooms</h5>
            <ul class="list-group">
                @if (Rooms.Count == 0)
                {
                    <li class="list-group-item">No rooms available.</li>
                }
                else
                {
                    @foreach (var room in Rooms)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@room.Value</span>
                            <span>
                                @if (CurrentRoomId != room.Key)
                                {
                                    <button class="btn btn-primary btn-sm me-1"
                                            @onclick="() => JoinRoom(room.Key)">
                                        Join
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-warning btn-sm me-1"
                                            @onclick="() => LeaveRoom(room.Key)">
                                        Leave
                                    </button>
                                }
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteRoom(room.Key)">
                                    Delete
                                </button>
                            </span>
                        </li>
                    }
                }
            </ul>
        </div>

        <!-- ── right column – chat window ───────────────────────────────── -->
        <div class="col-md-8">
            <h4>
                @if (string.IsNullOrEmpty(CurrentRoomId))
                {
                    <span>Not in a room</span>
                }
                else
                {
                    <span>Chat room: @Rooms[CurrentRoomId]</span>
                }
            </h4>

            <div class="row">
                <!-- chat messages -->
                <div class="col-md-8">
                    <div class="input-group mb-2">
                        <input class="form-control"
                               placeholder="Type a message..."
                               @bind="MessageInput" />

                        <button class="btn btn-primary"
                                disabled="@(string.IsNullOrEmpty(CurrentRoomId) || !IsConnected)"
                                @onclick="SendMessageToRoom">
                            Send
                        </button>
                    </div>

                    <hr />

                    <ul class="list-unstyled">
                        @foreach (var msg in ChatMessages)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>

                <!-- user list -->
                <div class="col-md-4">
                    <h5>Users in room</h5>
                    <ul class="list-group">
                        @if (RoomUsers.Count == 0)
                        {
                            <li class="list-group-item">No users in this room.</li>
                        }
                        else
                        {
                            @foreach (var user in RoomUsers)
                            {
                                <li class="list-group-item">@user</li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private HubConnection?                         hubConnection;
    private string                                _userName     = string.Empty;
    private bool                                  _isRegistered = false;
    private Dictionary<string, string>            Rooms          = new();
    private string?                               CurrentRoomId;
    private string?                               CreateRoomName;
    private string?                               MessageInput;
    private List<string>                          ChatMessages   = new();
    private List<string>                          RoomUsers      = new();
    private string                                ErrorMessage   = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // build connection to the hub (ensure lowercase path)
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"))
            .WithAutomaticReconnect()
            .Build();

        // subscribe to server events
        hubConnection.On<bool>("Register", HandleRegisterResult);
        hubConnection.On<string, string>("ReceiveMessage", AddMessage);
        hubConnection.On<Dictionary<string, string>>("AllRooms", rooms =>
        {
            Rooms = rooms;
            StateHasChanged();
        });
        hubConnection.On<string, string>("RoomCreated", (id, name) =>
        {
            Rooms[id] = name;
            StateHasChanged();
        });
        hubConnection.On<string>("RoomDeleted", id =>
        {
            Rooms.Remove(id);
            if (CurrentRoomId == id) CurrentRoomId = null;
            StateHasChanged();
        });
        hubConnection.On<string>("Error", ShowError);
        hubConnection.On<List<string>>("RoomUsers", users =>
        {
            RoomUsers = users;
            StateHasChanged();
        });

        await hubConnection.StartAsync();

    }

    private void HandleRegisterResult(bool ok)
    {
        _isRegistered = ok;
        if (ok)
        {
            ErrorMessage = string.Empty;
            _ = hubConnection!.SendAsync("GetRooms");
        }
        else
        {
            ErrorMessage = "Nickname already taken. Choose another.";
        }
        StateHasChanged();
    }

    private void AddMessage(string user, string message)
    {
        ChatMessages.Add($"{user}: {message}");
        StateHasChanged();
    }

    private void ShowError(string error)
    {
        ErrorMessage = error;
        StateHasChanged();
        _ = Task.Delay(5000).ContinueWith(_ =>
        {
            ErrorMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task ConfirmUserName()
    {
        if (string.IsNullOrWhiteSpace(_userName))
        {
            ErrorMessage = "Please enter a nickname.";
            return;
        }
        await hubConnection!.SendAsync("Register", _userName);
    }

    private Task CreateRoom() =>
        string.IsNullOrWhiteSpace(CreateRoomName)
            ? Task.CompletedTask
            : hubConnection!.SendAsync("CreateRoom", CreateRoomName)
                .ContinueWith(_ => CreateRoomName = string.Empty);

    private Task DeleteRoom(string id) =>
        hubConnection!.SendAsync("DeleteRoom", id);

    private async Task JoinRoom(string id)
    {
        if (!_isRegistered)
        {
            ErrorMessage = "Register a nickname first.";
            return;
        }

        if (!string.IsNullOrEmpty(CurrentRoomId))
            await hubConnection!.SendAsync("LeaveRoom", CurrentRoomId);

        await hubConnection!.SendAsync("JoinRoom", id);
        CurrentRoomId = id;
        ChatMessages.Clear();
    }

    private async Task LeaveRoom(string id)
    {
        await hubConnection!.SendAsync("LeaveRoom", id);
        if (CurrentRoomId == id)
        {
            CurrentRoomId = null;
            ChatMessages.Add("*** you left the room ***");
        }
    }

    private Task SendMessageToRoom()
    {
        if (string.IsNullOrEmpty(CurrentRoomId) || string.IsNullOrWhiteSpace(MessageInput))
            return Task.CompletedTask;

        var task = hubConnection!.SendAsync("SendMessage", CurrentRoomId, MessageInput);
        MessageInput = string.Empty;
        return task;
    }

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
            await hubConnection.DisposeAsync();
    }
}
