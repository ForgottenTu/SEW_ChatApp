@page "/chat"
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Http
@implements IAsyncDisposable
@inject NavigationManager Nav
@inject ILogger<Chat> Log
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpCtx
@rendermode InteractiveServer

<PageTitle>Chat</PageTitle>

@if (!_isRegistered)
{
    <div class="d-flex flex-column align-items-center mt-5">
        <h3 class="mb-4">Welcome to the Chat</h3>
        <button class="btn btn-primary px-4 py-2" @onclick="ConfirmUserName">Enter Chat</button>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger mt-3 w-100 text-center">@ErrorMessage</div>
        }
    </div>
}
else
{
    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 mb-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">Hello, @_userName!</h5>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger mt-3">@ErrorMessage</div>
                        }

                        <div class="mt-4">
                            <h6>Create Room</h6>
                            <div class="input-group mb-3">
                                <input class="form-control" placeholder="Room name" @bind="CreateRoomName" />
                                <button class="btn btn-success" @onclick="CreateRoom">Create</button>
                            </div>
                        </div>

                        <h6>Available Rooms</h6>
                        <div class="list-group">
                            @foreach (var room in Rooms)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@room.Value</span>
                                    <div class="btn-group">
                                        @if (CurrentRoomId != room.Key)
                                        {
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => JoinRoom(room.Key)">Join</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => LeaveRoom(room.Key)">Leave</button>
                                        }
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoom(room.Key)">Delete</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chat Main Panel -->
            <div class="col-lg-9">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title">
                            @(string.IsNullOrEmpty(CurrentRoomId) ? "Not in a room" : $"Room: {Rooms[CurrentRoomId]}")
                        </h5>

                        <div class="row mt-4">
                            <!-- Chat Box -->
                            <div class="col-md-8">
                                <div class="input-group mb-3">
                                    <input class="form-control" placeholder="Type a message..." @bind="MessageInput" />
                                    <button class="btn btn-primary" disabled="@(string.IsNullOrEmpty(CurrentRoomId) || !IsConnected)" @onclick="SendMessageToRoom">Send</button>
                                </div>

                                <div class="chat-box border rounded p-3 mb-3" style="height: 300px; overflow-y: auto;">
                                    @if (ChatMessages.Count == 0)
                                    {
                                        <p class="text-muted">No messages yet.</p>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var msg in ChatMessages)
                                            {
                                                <li class="mb-1">@msg</li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>

                            <!-- User List -->
                            <div class="col-md-4">
                                <h6>Users in Room</h6>
                                <ul class="list-group">
                                    @foreach (var user in RoomUsers)
                                    {
                                        <li class="list-group-item">@user</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}


@code {
    /*──────────────────────────────  Connection  ──────────────────────────────*/

    private HubConnection? hubConnection;
    private string _userName = "";
    private bool _isRegistered = false;

    /*──────────────────────────────  State  ─────────────────────────────────*/

    private Dictionary<string, string> Rooms = new();
    private string? CurrentRoomId;
    private string? CreateRoomName;
    private string? MessageInput;

    private readonly List<string> ChatMessages = new();
    private readonly List<string> RoomUsers     = new();

    private string ErrorMessage = string.Empty;

    /*──────────────────────────  Lifecycle  ───────────────────────────────*/

    protected override async Task OnInitializedAsync()
    {
        // Figure out who we are (after Identity auth)
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user      = authState.User;
        _userName     = user.Identity?.Name ?? "Guest";

        // Build a CookieContainer that carries the Identity cookie into the
        // *server‑side* HubConnection. Without this step the hub sees an
        // anonymous user.
        var cookieJar = new CookieContainer();
        cookieJar.Add(new Uri(Nav.BaseUri),
            new Cookie(".AspNetCore.Identity.Application",
                HttpCtx.HttpContext?.Request.Cookies[".AspNetCore.Identity.Application"]));

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/chathub"), o =>
            {
                o.HttpMessageHandlerFactory = _ => new HttpClientHandler
                {
                    CookieContainer = cookieJar,
                    UseCookies      = true
                };
            })
            .WithAutomaticReconnect()
            .Build();

        RegisterHubHandlers();
        await hubConnection.StartAsync();

        await ConfirmUserName();
    }

    private void RegisterHubHandlers()
    {
        if (hubConnection is null) return;

        hubConnection.On<bool>("Register", HandleRegisterResult);
        hubConnection.On<string, string>("ReceiveMessage", AddMessage);
        hubConnection.On<Dictionary<string, string>>("AllRooms", rooms =>
        {
            Rooms = rooms; InvokeAsync(StateHasChanged);
        });
        hubConnection.On<string, string>("RoomCreated", (id, name) =>
        {
            Rooms[id] = name; InvokeAsync(StateHasChanged);
        });
        hubConnection.On<string>("RoomDeleted", id =>
        {
            Rooms.Remove(id);
            if (CurrentRoomId == id) CurrentRoomId = null;
            InvokeAsync(StateHasChanged);
        });
        hubConnection.On<string>("Error", ShowError);
        hubConnection.On<List<string>>("RoomUsers", users =>
        {
            RoomUsers.Clear(); RoomUsers.AddRange(users); InvokeAsync(StateHasChanged);
        });
    }

    /*─────────────────────────────  Hub calls  ─────────────────────────────*/

    private async Task ConfirmUserName()
    {
        if (hubConnection is null) return;
        await hubConnection.SendAsync("Register", _userName);
    }

    private void HandleRegisterResult(bool ok)
    {
        _isRegistered = ok;
        if (!ok) ErrorMessage = "Could not register username.";
        else hubConnection!.SendAsync("GetRooms");
        InvokeAsync(StateHasChanged);
    }

    private void AddMessage(string user, string message) => ChatMessages.Add($"{user}: {message}");

    private void ShowError(string error)
    {
        ErrorMessage = error; InvokeAsync(StateHasChanged);
    }

    private Task CreateRoom() => !string.IsNullOrWhiteSpace(CreateRoomName)
        ? hubConnection!.SendAsync("CreateRoom", CreateRoomName)
        : Task.CompletedTask;

    private Task DeleteRoom(string id) => hubConnection!.SendAsync("DeleteRoom", id);

    private async Task JoinRoom(string id)
    {
        if (!string.IsNullOrEmpty(CurrentRoomId))
            await hubConnection!.SendAsync("LeaveRoom", CurrentRoomId);

        await hubConnection!.SendAsync("JoinRoom", id);
        CurrentRoomId = id; ChatMessages.Clear();
    }

    private async Task LeaveRoom(string id) => await hubConnection!.SendAsync("LeaveRoom", id);

    private Task SendMessageToRoom() => hubConnection!.SendAsync("SendMessage", CurrentRoomId, MessageInput);

    /*────────────────────────────────  Helpers  ───────────────────────────*/

    public bool IsConnected => hubConnection?.State == HubConnectionState.Connected;

    public async ValueTask DisposeAsync() =>
        await hubConnection!.DisposeAsync();
}
